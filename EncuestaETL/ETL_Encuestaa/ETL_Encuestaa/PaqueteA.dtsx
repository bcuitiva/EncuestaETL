      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8E5E22E2-8B01-4B24-94C6-218B88DB9236}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.EtlEjecucion&#xA;(&#xA;    Paquete,&#xA;    FechaEjecucion,&#xA;    Leidos,&#xA;    Validos,&#xA;    Revision,&#xA;    Rechazados,&#xA;    Duplicados,&#xA;    PersonasInsertadas,&#xA;    ObservacionesInsertadas&#xA;)&#xA;VALUES&#xA;(&#xA;    'PaqueteA',&#xA;    SYSDATETIME(),&#xA;    (SELECT COUNT(*) FROM dbo.stg_Personas),&#xA;    (SELECT COUNT(*) FROM dbo.stg_Limpio),&#xA;    (SELECT COUNT(*) FROM dbo.EtlRechazo WHERE Estado = 'REVISION'),&#xA;    (SELECT COUNT(*) FROM dbo.EtlRechazo WHERE Estado = 'RECHAZO'),&#xA;    (SELECT COUNT(*) FROM dbo.EtlRechazo WHERE Estado = 'DUPLICADO'),&#xA;    ?,&#xA;    ?&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::vPersonasIns"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::vObsIns"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
