                      name="TiempoKey"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión de columna derivada"
                          name="Expression">(DT_I4)([YEAR](#{Package\DF Dimensiones\Una Fila por Fecha.Outputs[Salida de agregado 1].Columns[Fecha]}) * 10000 + [MONTH](#{Package\DF Dimensiones\Una Fila por Fecha.Outputs[Salida de agregado 1].Columns[Fecha]}) * 100 + [DAY](#{Package\DF Dimensiones\Una Fila por Fecha.Outputs[Salida de agregado 1].Columns[Fecha]}))</property>
